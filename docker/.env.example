# Docker Asterisk settings. Copy to .env and edit:  cp .env.example .env
# docker compose reads .env from this folder automatically.

# Image version (tags: https://hub.docker.com/r/andrius/asterisk/tags)
ASTERISK_IMAGE=andrius/asterisk:22.11.0_debian-trixie

# Your user's id (run: id -u / id -g) so mounted folders stay writable
PUID=1000
PGID=1000

# SIP: phones register to this port (UDP)
SIP_PORT=5060
# Set to the IP phones use as "server" when calling over Tailscale/NAT
# (e.g. output of `tailscale ip -4`). Leave empty on a plain LAN.
EXTERNAL_IP=

# RTP audio ports (open these in the firewall for calls from outside the LAN)
RTP_START=10000
RTP_END=10100

# Phone logins (user = extension number)
PHONE_1001_PASSWORD=1001
PHONE_1002_PASSWORD=1002

# ARI: must match ARI_PORT / ARI_USERNAME / ARI_PASSWORD in the project .env
ARI_BIND=127.0.0.1
ARI_PORT=8088
ARI_USERNAME=callbot
ARI_PASSWORD=1001

# Extension phones dial to reach the bot, and the Stasis app name (STASIS_APP in project .env)
BOT_EXTENSION=7001
STASIS_APP=callbot

# ---- Databases (redis + postgres services) ----
# Must match REDIS_URL / DATABASE_URL in the project .env
REDIS_PORT=6379
REDIS_PASSWORD=callbot
POSTGRES_PORT=5432
POSTGRES_DB=callbot
POSTGRES_USER=callbot
POSTGRES_PASSWORD=callbot

# Codecs offered to phones, in order of preference. ulaw first is the safe default.
# g722 (HD, 16 kHz) sounds better but some softphones play it slow/garbled; to try it:
# CODECS=g722,ulaw,alaw
CODECS=ulaw,alaw,g722
