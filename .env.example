# Copy to .env and edit. Never commit .env to git.

# --- Asterisk ARI (enable HTTP in /etc/asterisk/http.conf) ---
ARI_HOST=127.0.0.1
ARI_PORT=8088
ARI_USERNAME=callbot
ARI_PASSWORD=change-me
STASIS_APP=callbot

# --- vLLM or any OpenAI-compatible API ---
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=your-model-id
VLLM_CONNECT_TIMEOUT_SECONDS=15
VLLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=96

# --- Speech-to-text (faster-whisper) ---
# Multilingual: large-v3, small, base, tiny (avoid *.en-only for Hindi)
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# --- Supertonic TTS (local ONNX, not cloud) ---
TTS_SOUND_SUBDIR=custom
SUPERTONIC_VOICE_FEMALE=F3
SUPERTONIC_VOICE_MALE=M1
SUPERTONIC_VOICE_EN=F3
SUPERTONIC_VOICE_HI=F3
SUPERTONIC_SPEED_HI=1.08
SUPERTONIC_SPEED_EN=1.22
SUPERTONIC_SILENCE_DURATION=0.12

# --- Greeting and language ---
# Hindi example; use English text for English-only deployments
OPENING_GREETING=Hi, how can I help you?
CALL_PRIMARY_LANG=hi
LANG_SWITCH_MIN_EN_WORDS=3
LANG_SWITCH_CONSECUTIVE_EN=1

# --- Turn-taking (milliseconds unless noted) ---
RECORD_MAX_SILENCE_SECONDS=1.2
RECORD_MAX_DURATION_SECONDS=45
RECORD_MIN_DURATION_SECONDS=0.35
PAUSE_AFTER_TTS_MS=350
PAUSE_BEFORE_LISTEN_MS=450
PAUSE_BEFORE_RESPONSE_MS=400

# --- Reply shaping before TTS ---
REPLY_MAX_SENTENCES=2
REPLY_MAX_CHARS=220
TTS_CHUNK_MAX_CHARS=140

# --- Per-call LLM memory (cleared on hangup) ---
SESSION_MAX_MESSAGES=20

# --- Caller pitch → male/female bot voice (optional) ---
GENDER_PITCH_FEMALE_MIN_HZ=165
GENDER_PITCH_MALE_MAX_HZ=155
GENDER_MIN_PITCH_SAMPLES=2

# --- Optional: uvicorn health server ---
# UVICORN_HOST=127.0.0.1
# UVICORN_PORT=8765
