# Copy to .env and edit. Never commit .env to git.
# cp .env.example .env

# Asterisk ARI (HTTP must be enabled in /etc/asterisk/http.conf)
ARI_HOST=127.0.0.1
ARI_PORT=8088
ARI_USERNAME=callbot
ARI_PASSWORD=change-me
STASIS_APP=callbot

# vLLM OpenAI-compatible API
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=google/gemma-4-E2B-it
VLLM_CONNECT_TIMEOUT_SECONDS=15
VLLM_TIMEOUT_SECONDS=120

# Speech (requires ffmpeg in PATH)
# faster-whisper: large-v3 = best multilingual quality on GPU (~3GB VRAM, float16)
WHISPER_MODEL=medium
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=1
WHISPER_VAD_FILTER=true
# Parallel STT/TTS (medium: 3 on GPU; large-v3: use 1–2)
WHISPER_MAX_CONCURRENT=3
TTS_FFMPEG_LIGHT=true
TTS_MAX_CONCURRENT=2
# INFERENCE_THREAD_WORKERS=0
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# WAV files Asterisk plays: /var/lib/asterisk/sounds/en/<TTS_SOUND_SUBDIR>/ (writable by the Linux user running the app)
TTS_SOUND_SUBDIR=custom

# TTS: supertonic (local, fast) or edge (clearer Hindi/English, needs network)
# TTS_BACKEND=edge
# EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural
# EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural
# EDGE_TTS_RATE=+0%

# Supertonic TTS (local). Lang hi/en from reply text (Devanagari -> hi).
# GPU (py311): pip install onnxruntime-gpu ONLY — uninstall onnxruntime (CPU) if both installed
# If logs show libcurand.so.10 missing, also:
# GPU wheels (onnxruntime-gpu +): nvidia-cuda-runtime-cu12 nvidia-cublas-cu12 nvidia-curand-cu12 nvidia-cudnn-cu12 nvidia-cufft-cu12
# ari_app/supertonic_onnx.py adds site-packages/nvidia/*/lib to LD_LIBRARY_PATH automatically
SUPERTONIC_USE_GPU=true
# SUPERTONIC_CUDA_DEVICE=0
# SUPERTONIC_ONNX_PROVIDERS=cuda,cpu
SUPERTONIC_VOICE_FEMALE=F3
# Male voice only used when AGENT_GENDER=male
SUPERTONIC_VOICE_MALE=M1
SUPERTONIC_VOICE_EN=F3
SUPERTONIC_VOICE_HI=F3

# Opening line: leave empty for dynamic greetings (time of day + variety each call).
# Set OPENING_GREETING to fix one line; OPENING_GREETING_DYNAMIC=false to always use it.
OPENING_GREETING=
OPENING_GREETING_DYNAMIC=true
CALL_PRIMARY_LANG=en
# Stay on Hindi until clear English (e.g. "continue" or full English sentence)

# Seconds of silence before Asterisk ends the recording (lower = snappier turns).
# 0.8–1.0 keeps the bot responsive without cutting off mid-sentence.
RECORD_MAX_SILENCE_SECONDS=0.9

# Telephonic turn-taking (default). For streaming LLM + shorter gaps, set both to true.
# CONTINUOUS_CONVERSATION=true gives the lowest end-to-end latency once tuned.
# CONTINUOUS_CONVERSATION=false
# LLM_STREAMING=false
# false = do not speak on silence/empty STT; just keep listening
PROMPT_ON_SILENCE=false
RECORD_MAX_DURATION_SECONDS=45
RECORD_MIN_DURATION_SECONDS=0.35
# End call after this many empty/silent turns in a row (no STT text / WAV too short)
RECORD_MAX_CONSECUTIVE_EMPTY=8
# Gaps: after bot speech -> before mic; after user speech -> before bot reply
PAUSE_AFTER_TTS_MS=80
PAUSE_BEFORE_LISTEN_MS=80
PAUSE_BEFORE_RESPONSE_MS=0

# AGENT_VOICE_GENDER = TTS voice (F3/M1). Bot Hindi (मैं करती) follows voice/persona, not caller.
# Caller gender (model/pitch) only shapes how you address them (आप), via caller_grammar_hint.
AGENT_GENDER=female
AGENT_VOICE_GENDER=female
GRAMMAR_MATCH_VOICE=true
HINDI_GRAMMAR_USE_AGENT_PERSONA=true
# false = do not mirror caller gender for bot self-reference (करता when caller is male)
GENDER_ADAPT_WHEN_CONFIDENT=false
GENDER_GRAMMAR_UNTIL_CONFIDENT=false
GENDER_GRAMMAR_MIN_TURNS=0
GENDER_DETECT_CALLER=true
GENDER_MIN_CONFIDENT_SAMPLES=5
GENDER_CONFIDENT_FRACTION=0.8
GENDER_MIRROR_CALLER=false
# Force male Hindi bot regardless of caller: AGENT_GENDER=male AGENT_VOICE_GENDER=male
GENDER_PITCH_FEMALE_MIN_HZ=170
GENDER_PITCH_MALE_MAX_HZ=145
GENDER_MIN_PITCH_SAMPLES=3

# Wav2Vec2 gender (prithivMLmods/Common-Voice-Geneder-Detection): once after lang lock, first long utterance
GENDER_MODEL_ENABLED=true
GENDER_MODEL_MIN_DURATION_SECONDS=2.0
GENDER_MODEL_MIN_CHARS=12
GENDER_MODEL_MIN_CONFIDENCE=0.55

# Natural phone replies (not robotic one-liners).
# One short sentence per turn is fastest; raise REPLY_MAX_* if you want longer answers.
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.7
REPLY_MAX_SENTENCES=2
# ~10 spoken words per turn; lower = faster phone turns
REPLY_MAX_CHARS=220
SUPERTONIC_SPEED_GREETING=1.0
SUPERTONIC_SPEED_EN=1.0
SUPERTONIC_SPEED_HI=1.02
SUPERTONIC_SPEED=1.0
SUPERTONIC_SILENCE_DURATION=0.2
TTS_TAIL_PAD_SECONDS=0
TTS_TAIL_FADE_MS=45
TTS_TRIM_TRAILING_SILENCE=true
TTS_POST_PLAY_SETTLE_MS=60
# Smaller chunks let synth/play overlap so the first audio arrives sooner.
TTS_CHUNK_MAX_CHARS=120

# Whisper VAD — lower silence keeps short answers (haan/nahi/yes/no) intact.
WHISPER_VAD_MIN_SILENCE_MS=250
WHISPER_VAD_SPEECH_PAD_MS=60

# LLM chat history kept for this call (user+assistant pairs; default 20 = ~10 turns)
SESSION_MAX_MESSAGES=20

# Web search: fast = DuckDuckGo snippets (~1 s), live page crawl only if empty.
# crawl = always crawl pages (more detail, 3-8 s). Crawl needs: playwright install chromium
# One-time: playwright install chromium
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=fast
CRAWL_MAX_PAGES=1
CRAWL_PAGE_TIMEOUT_SECONDS=12
WEB_SEARCH_NUM_RESULTS=3
WEB_SEARCH_TIMEOUT_SECONDS=15
# Optional API fallbacks when crawl fails (WEB_SEARCH_PROVIDER=auto tries these next):
# SERPAPI_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# uvicorn when using: python -m ari_app.server (defaults shown; uncomment to override)
# UVICORN_HOST=127.0.0.1
# UVICORN_PORT=8765
# UVICORN_LOG_LEVEL=info

# HD audio: 16 kHz .wav16 twin (used on G.722 calls), loudness normalization, wideband recording
TTS_WIDEBAND=true
TTS_LOUDNORM=true
TTS_LOUDNESS_LUFS=-18
RECORD_FORMAT=wav16

# Bot replies in whatever language the caller speaks (no language question).
# Switch only when the caller says >= this many words and Whisper is this confident.
LANG_SWITCH_MIN_WORDS=2
LANG_SWITCH_MIN_PROB=0.6

# Copy of the console log on disk (rotates at 5 MB)
LOG_FILE=logs/callbot.log

# End the caller turn with live voice detection (Silero) instead of Asterisk silence threshold
VAD_ENABLED=true
VAD_END_SILENCE_MS=700
VAD_SPEECH_THRESHOLD=0.5
VAD_NO_SPEECH_TIMEOUT_SECONDS=8

# Caller can interrupt the bot while it is speaking (needs VAD_ENABLED)
BARGE_IN_ENABLED=true
BARGE_IN_THRESHOLD=0.7
BARGE_IN_MIN_SPEECH_MS=400
