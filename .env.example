# Copy to .env and edit. Never commit .env to git.
# cp .env.example .env

# Asterisk ARI (HTTP must be enabled in /etc/asterisk/http.conf)
ARI_HOST=127.0.0.1
ARI_PORT=8088
ARI_USERNAME=callbot
ARI_PASSWORD=change-me
STASIS_APP=callbot

# vLLM OpenAI-compatible API
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=google/gemma-4-E2B-it
VLLM_CONNECT_TIMEOUT_SECONDS=15
VLLM_TIMEOUT_SECONDS=120

# Speech (requires ffmpeg in PATH)
# faster-whisper: large-v3 = best multilingual quality on GPU (~3GB VRAM, float16)
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# WAV files Asterisk plays: /var/lib/asterisk/sounds/en/<TTS_SOUND_SUBDIR>/ (writable by the Linux user running the app)
TTS_SOUND_SUBDIR=custom

# Supertonic TTS (local). Lang hi/en from reply text (Devanagari -> hi).
SUPERTONIC_VOICE_FEMALE=F3
# Male voice only used when AGENT_GENDER=male
SUPERTONIC_VOICE_MALE=M1
SUPERTONIC_VOICE_EN=F3
SUPERTONIC_VOICE_HI=F3

# Opening line after answer (English; set Hindi text if CALL_PRIMARY_LANG=hi only)
OPENING_GREETING=Hi, how can I help you today?
CALL_PRIMARY_LANG=en
# Stay on Hindi until clear English (e.g. "continue" or full English sentence)
LANG_SWITCH_MIN_EN_WORDS=3
LANG_SWITCH_CONSECUTIVE_EN=1

# Seconds of silence before Asterisk ends the recording (1.6–2.2 feels natural)
RECORD_MAX_SILENCE_SECONDS=1.4

# Telephonic turn-taking (default). For streaming LLM + shorter gaps, set both to true.
# CONTINUOUS_CONVERSATION=false
# LLM_STREAMING=false
# false = do not speak on silence/empty STT; just keep listening
PROMPT_ON_SILENCE=false
RECORD_MAX_DURATION_SECONDS=45
RECORD_MIN_DURATION_SECONDS=0.35
# Gaps: after bot speech -> before mic; after user speech -> before bot reply
PAUSE_AFTER_TTS_MS=200
PAUSE_BEFORE_LISTEN_MS=250
PAUSE_BEFORE_RESPONSE_MS=120

# AGENT_GENDER=female → F3 voice; LLM stays gender-neutral (informative general chat).
# GENDER_GRAMMAR_UNTIL_CONFIDENT: extra-neutral early turns until pitch + min turns
AGENT_GENDER=female
AGENT_VOICE_GENDER=female
GRAMMAR_MATCH_VOICE=false
GENDER_GRAMMAR_UNTIL_CONFIDENT=true
GENDER_GRAMMAR_MIN_TURNS=2
GENDER_DETECT_CALLER=true
GENDER_ADAPT_WHEN_CONFIDENT=true
GENDER_MIN_CONFIDENT_SAMPLES=5
GENDER_CONFIDENT_FRACTION=0.8
GENDER_MIRROR_CALLER=false
GENDER_PITCH_FEMALE_MIN_HZ=170
GENDER_PITCH_MALE_MAX_HZ=145
GENDER_MIN_PITCH_SAMPLES=3

# Natural phone replies (not robotic one-liners)
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.82
REPLY_MAX_SENTENCES=2
REPLY_MAX_CHARS=260
SUPERTONIC_SPEED_GREETING=1.06
SUPERTONIC_SPEED_EN=1.06
SUPERTONIC_SPEED_HI=1.08
SUPERTONIC_SPEED=1.08
SUPERTONIC_SILENCE_DURATION=0.18
TTS_TAIL_PAD_SECONDS=0.15
TTS_CHUNK_MAX_CHARS=280

# LLM chat history kept for this call (user+assistant pairs; default 20 = ~10 turns)
SESSION_MAX_MESSAGES=20

# uvicorn when using: python -m ari_app.server (defaults shown; uncomment to override)
# UVICORN_HOST=127.0.0.1
# UVICORN_PORT=8765
# UVICORN_LOG_LEVEL=info
